_MONTH_NAMES = ("January", "February", "March", "April", "May", "June", "July",
                "August", "September", "October", "November", "December")

def _month_label(ym: str) -> str:
    """'2026-08' → '2026-08  (August 2026)'."""
    try:
        y, m = ym.split("-")
        return f"{ym}  ({_MONTH_NAMES[int(m) - 1]} {y})"
    except (ValueError, IndexError):
        return ym

def month_detail_view(months: list[str], i: int) -> None:
    """Single-month detail with ←/→ (or [ / ]) navigation between months.

    `months` is sorted newest-first, so → moves to a newer month (index down)
    and ← to an older one (index up) — matching the intuitive timeline
    direction of the arrow keys.
    """
    while True:
        m = months[i]
        title = f"Usage & cost · {_month_label(m)}"
        text = run_script("cost-report.sh", "--month", m)
        _paint(title, text)
        parts = ["[Enter] refresh"]
        if i + 1 < len(months):
            parts.append("[←] older")
        if i > 0:
            parts.append("[→] newer")
        parts.append("[p] page")
        parts.append("[Esc] back")
        sys.stdout.write(" · ".join(parts) + "  ")
        sys.stdout.flush()
        ch = _read_one_key()
        sys.stdout.write("\n")
        if ch in ("\n", "\r", " ", "r", "R"):
            continue
        if ch in ("LEFT", "[", ",") and i + 1 < len(months):
            i += 1
            continue
        if ch in ("RIGHT", "]", ".") and i > 0:
            i -= 1
            continue
        if ch in ("p", "P"):
            try:
                subprocess.run(
                    ["less", "-R", "-X"],
                    input=_banner_frame(title, text),
                    text=True,
                )
            except Exception:
                pass
            continue
        return

def monthly_flow() -> None:
