# ---------- merged projects ----------

def new_group_wizard(projects: list[L.Project]) -> L.Group | None:
    by_slug = {p.slug: p for p in projects}
    primary = pick_folder(
        "cct · New merged project",
        "Step 1 of 2 — pick the PRIMARY folder: the project as it is today.\n"
        "(gone) = an old location whose folder no longer exists on disk.  / filters the list.",
        projects, exclude=set(),
    )
    if primary is None:
        return None
    members: list[str] = []
    while True:
        chosen = "\n".join(f"  + {by_slug[s].label}" for s in members) or "  (none yet)"
        sub = (f"Step 2 of 2 — add the folders to count together with ★ {primary.label}\n"
               f"{chosen}\n"
               "Enter adds a folder; pick Done to save.  Esc cancels.")
        items: list[tuple] = [("done", f"✓  Done — save with {len(members)} extra folder(s)")]
        items += [(p.slug, _folder_label(p)) for p in projects
                  if p.slug != primary.slug and p.slug not in members]
        choice = menu("cct · New merged project", sub, items, default="done" if members else None)
        if choice is None:
            return None
        if choice == "done":
            if members:
                break
            render_output("Nothing to merge",
                          "Add at least one more folder — a merged project of one folder\n"
                          "is just the project itself (see Cost by project).\n")
            continue
        members.append(choice)
    groups = L.load_groups()
    taken = {g.name for g in groups}
    base = primary.name
    name, i = base, 2
    while name in taken:
        name, i = f"{base}-{i}", i + 1
    typed = prompt_line(
        "cct · New merged project · name",
        f"Primary: {primary.label}\nFolders: {len(members) + 1}\n\nEnter keeps the suggested name.",
        "Name", name,
    )
    if typed is None:
        return None
    typed = typed.strip().lstrip("-")   # a leading '-' would read as a CLI option
    if not typed or typed in taken:
        typed = name
    g = L.Group(name=typed, primary=primary.slug, members=members)
    groups.append(g)
    L.save_groups(groups)
    render_output("Merged project saved",
                  f"⊕ {g.name}\n{group_lines(g, by_slug)}\n\n"
                  f"Saved to {L.home_rel(str(L.MERGES_FILE))}.\n"
                  "Cost, sessions, time and export for this merged project live under\n"
                  "Merged projects → pick it. Plain per-folder views are unchanged.\n")
    return g

def edit_members(g: L.Group, projects: list[L.Project]) -> None:
    by_slug = {p.slug: p for p in projects}
    while True:
        items: list[tuple] = [("add", "+  Add a folder…")]
        for s in g.slugs:
            p = by_slug.get(s)
            lbl = (p.label + ("  (gone)" if not p.alive else "")) if p else f"{s}  (folder missing)"
            if s == g.primary:
                items.append((s, f"★ {lbl}   — primary"))
            else:
                items.append((s, f"+ {lbl}   — Enter removes"))
        choice = menu(f"cct · ⊕ {g.name} · folders",
                      "Enter on a folder removes it from the merged project (the primary stays).\n"
                      "Esc when done.", items, default="add")
        if choice is None:
            return
        if choice == "add":
            p = pick_folder(f"cct · add a folder to ⊕ {g.name}",
                            "Folders already in this merged project are hidden.\n"
                            "(gone) = old location that no longer exists on disk.",
                            projects, exclude=set(g.slugs))
            if p is not None:
                g.members.append(p.slug)
                _persist_group(g.name, g)
        elif choice == g.primary:
            render_output("Primary folder",
                          "The primary folder can't be removed. Delete this merged project and\n"
                          "create a new one if you want a different primary.\n")
        else:
            g.members = [m for m in g.members if m != choice]
            _persist_group(g.name, g)

def group_menu(g: L.Group, projects: list[L.Project]) -> str | None:
    """Actions for one merged project. Returns 'deleted' when it was removed."""
    by_slug = {p.slug: p for p in projects}
    default = "cost"
    while True:
        action = menu(f"cct · Merged project ⊕ {g.name}",
                      group_lines(g, by_slug) + "\n", GROUP_ITEMS, default=default)
        if action is None or action == "back":
            return None
        default = action
        if action == "cost":
            render_output_refresh(
                lambda v, n=g.name: f"Daily cost — ⊕ {n}" + (" (extended)" if v else ""),
                lambda v, n=g.name: run_script(
                    "project-costs.sh", "--merged", "--dates", n, *(["-v"] if v else [])),
                variants=2, variant_names=("summary", "extended"),
            )
        elif action == "sessions":
            sessions: list[Session] = []
            for d in L.group_dirs(g):
                sessions.extend(sessions_in(d))
            sessions.sort(key=lambda s: s.last or "", reverse=True)
            do_session_flow(sessions, title=f"⊕ {g.name}", with_project=True)
        elif action == "time":
            render_output_refresh(
                lambda v, n=g.name: f"Time {'per session' if v else 'by date'} — ⊕ {n}",
                lambda v, n=g.name: run_script(
                    "time-report.py", "--merged", "--sessions" if v else "--dates", n),
                variants=2, variant_names=("by date", "per session"),
            )
        elif action == "export":
            export_run(["--merged", g.name], g.name)
        elif action == "members":
            edit_members(g, projects)
        elif action == "rename":
            new = prompt_line(f"cct · rename ⊕ {g.name}",
                              "Ctrl-C keeps the current name.", "New name", g.name)
            new = new.strip().lstrip("-") if new else None
            if new and new != g.name:
                if any(x.name == new for x in L.load_groups()):
                    render_output("Rename", f"A merged project named '{new}' already exists.\n")
                else:
                    old = g.name
                    g.name = new
                    _persist_group(old, g)
        elif action == "delete":
            sure = menu(f"cct · delete ⊕ {g.name}?",
                        "Only the binding is removed. Transcripts under ~/.claude/projects/ are never touched.",
                        [("no", "No, keep it"), ("yes", "Yes, delete this merged project")],
                        default="no")
            if sure == "yes":
                L.save_groups([x for x in L.load_groups() if x.name != g.name])
                return "deleted"

def merged_flow() -> None:
    projects = L.discover_projects(include_empty=True)
    last = "new"
    while True:
        groups = L.load_groups()
        items: list[tuple] = [("new", "+  New merged project…")]
        if groups:
            items.append(("summary", "All merged projects — cost summary (v: per folder)"))
        items += [(f"g:{g.name}", f"⊕ {g.name}  ({len(L.group_dirs(g))} folders)") for g in groups]
        choice = menu(
            "cct · Merged projects",
            "Count several folders as one project: a project that moved or was renamed (old location\n"
            "+ new), or a repo opened from more than one subfolder. Bindings live in ~/.config/cct.\n"
            "Cost by project / Sessions keep showing folders one by one; this menu shows them merged.",
            items, default=last,
        )
        if choice is None:
            return
        last = choice
        if choice == "new":
            g = new_group_wizard(projects)
            if g is not None:
                last = f"g:{g.name}"
        elif choice == "summary":
            render_output_refresh(
                lambda v: "Cost by merged project" + (" (per folder)" if v else ""),
