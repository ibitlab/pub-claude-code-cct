        render_output("Export prompts", "No projects found under ~/.claude/projects/.\n")
        return
    last = None
    while True:
        choice = menu(
            "cct · Export prompts",
            "Pick a project (⊕ = merged project). Then choose the format and where to write.\n"
            "Text: one file per session, prompts verbatim.  JSON: one file with per-prompt stats.",
            items, default=last,
