        if choice is None:
            return
        last = choice
        if choice.startswith("g:"):
            export_run(["--merged", choice[2:]], choice[2:])
        else:
            p = next(p for p in projects if p.slug == choice[2:])
            export_run([str(p.dir)], p.name)   # folder path: a slug starts with '-'

