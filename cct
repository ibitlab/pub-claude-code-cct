def export_run(args: list[str], name: str) -> None:
    """Format menu → destination prompt → export-prompts.py → result screen."""
    fmt = menu("cct · Export prompts · format", f"Exporting: {name}", FORMAT_ITEMS, default="text")
    if fmt is None:
        return
    base = Path(os.environ.get("CCT_EXPORT_DIR") or (Path.home() / "cct-export"))
    default_dir = str(base / _safe_name(name))
    out = prompt_line(
        "cct · Export prompts · destination",
        f"Exporting: {name}\nFormat:    {'one JSON file' if fmt == 'json' else 'one text file per session'}\n\n"
        "Where to write? Enter keeps the default, Ctrl-C cancels.\n"
        "Existing files are never overwritten — the export stops and tells you if any are in the way.",
        "Output directory", default_dir,
    )
    if out is None:
        return
    extra = ["--json"] if fmt == "json" else []
    render_output(f"Export prompts · {name}",
                  run_script("export-prompts.py", *args, "-o", out, *extra))

