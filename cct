# ---------- text input, project pickers ----------

def _drain_stdin() -> None:
    """Throw away typeahead left over from curses (a queued Enter would
    otherwise accept the default of the next line prompt unread)."""
    try:
        import termios, select  # noqa: F401  (POSIX only)
        fd = sys.stdin.fileno()
        while select.select([fd], [], [], 0)[0]:
            os.read(fd, 1)
    except Exception:
        pass

def text_input(label: str, default: str) -> str | None:
    """One line of plain (cooked-mode) input, used outside curses for names
    and paths. Enter keeps `default`; Ctrl-C / Ctrl-D cancel → None."""
    _drain_stdin()
    try:
        s = input(f"{label} [{default}]: ")
    except (EOFError, KeyboardInterrupt):
        sys.stdout.write("\n")
        return None
    s = s.strip()
    return s or default

def prompt_line(title: str, text: str, label: str, default: str) -> str | None:
    """Clear the screen, show `text` under a banner, then ask one line."""
    _paint(title, text + "\n")
    return text_input(label, default)

def _folder_label(p: L.Project) -> str:
    gone = "  (gone)" if not p.alive else ""
    return f"{p.sessions:>3} sess  {p.label}{gone}"

def pick_folder(title: str, subtitle: str, projects: list[L.Project],
                exclude: set[str]) -> L.Project | None:
    items = [(p.slug, _folder_label(p)) for p in projects if p.slug not in exclude]
    if not items:
        render_output(title, "No more folders to pick from.\n")
        return None
    choice = menu(title, subtitle, items)
    if choice is None:
        return None
    return next(p for p in projects if p.slug == choice)

def group_lines(g: L.Group, by_slug: dict) -> str:
    """One line per folder of a merged project; ★ marks the primary."""
    out = []
    for s in g.slugs:
        p = by_slug.get(s)
        mark = "★" if s == g.primary else "+"
        if p is None:
            out.append(f"  {mark} {s}  (folder missing)")
        else:
            gone = "  (gone)" if not p.alive else ""
            out.append(f"  {mark} {p.label}{gone}  · {p.sessions} sess")
    return "\n".join(out)

def _persist_group(old_name: str, g: L.Group) -> None:
    groups = L.load_groups()
    groups = [g if x.name == old_name else x for x in groups]
    if g not in groups:
        groups.append(g)
    L.save_groups(groups)

def _safe_name(name: str) -> str:
    return name.replace("/", "-").strip() or "export"

