def do_session_flow(sessions: list[Session], title: str, with_project: bool):
    while True:
        picked = session_picker(sessions, title, with_project)
        if picked is None:
            return
        label = f"{picked.short_id} · {picked.title or picked.headline}"
        while True:
            action = action_menu(picked)
            if action is None or action == "back":
                break
            if action == "stats":
                render_output(f"Stats + cost · {label}",
                              run_script("session-stats.sh", picked.id))
            elif action == "time":
                render_output_refresh(
                    lambda v, lbl=label: f"Time breakdown{' + per turn' if v else ''} · {lbl}",
                    lambda v, sid=picked.id: run_script(
                        "time-report.py", "--session", sid, *(["-v"] if v else [])
                    ),
                    variants=2,
                    variant_names=("summary", "per turn"),
                )
            elif action == "export":
                name = os.path.basename(picked.cwd.rstrip("/")) if picked.cwd else "session"
                export_run(["--session", picked.id], name)
            elif action == "tools":
                render_output_refresh(
                    lambda v, lbl=label: f"Tool usage{' + bash commands' if v else ''} · {lbl}",
                    lambda v, sid=picked.id: run_script(
                        "session-tools.sh", sid, *(["--commands"] if v else [])
                    ),
                    variants=2,
                    variant_names=("summary", "with bash commands"),
                )
            elif action == "questions":
                render_output(f"Your prompts · {label}",
                              run_script("session-questions.sh", picked.id))

CCT_VERSION = "0.5.0"

HELP_TEXT = """\
cct — interactive TUI for Claude Code session transcripts.

Usage:
  cct             Launch the interactive menu (default).
  cct -h, --help  Show this help and exit.
  cct --version   Print version and exit.

Environment:
  CCT_PAGER       auto (default) | never   Control whether long outputs are
                  paged through `less -R`.
  CCT_EXPORT_DIR  Where "Export prompts" writes (default ~/cct-export).
  CCT_DAY_START   Hour at which a "day" starts in Time analytics (default 0;
                  4 keeps a session that crosses midnight on one date).

Inside the TUI:
  ↑/↓ or j/k       Move cursor.
  PgUp / PgDn      Page through a long list.
  Home / End       First / last item.
  1–9              Jump to absolute row number (picker only).
  /                Filter the current list (picker only).
  Enter            Select / refresh a live view.
  v                Toggle short ↔ extended on views that have both
                   (cost / stack / tool usage / time).
  ←/→ or [/]       Older / newer month in the by-month detail view.
  p                Page the current view through `less -R` (scroll back
                   within the view when output overflows the terminal).
  Esc, q, ⌫        Back one level.
  Ctrl-C           Quit from anywhere.

Menus:
  Merged projects  Bind an old location (folder gone) or a split-off
                   folder to a primary project; cost / sessions / time /
                   export then count them together. Bindings are stored in
                   ~/.config/cct/merges.json; per-folder views are unchanged.
  Time analytics   Claude working / tools running / waiting on you / you,
                   per project, per day, per session, per turn.  Answering a
                   permission dialog counts as tools, not waiting, and "you"
                   is the gap to your next prompt, not observed presence;
                   every table repeats both caveats underneath.
  Export prompts   Your typed prompts, one text file per session
                   (YYYY-MM-DD_HHMM_<id>.txt) or one JSON with per-prompt
                   timestamps, reply time, tool calls and cost.

Scripts invoked under the hood live next to this file and can be used
standalone: list-sessions.sh, session-stats.sh, session-tools.sh,
session-questions.sh, active-sessions.sh, cost-report.sh, project-costs.sh,
stack-report.sh, dead-sessions.sh, status.sh, time-report.py,
export-prompts.py.
"""

def main() -> int:
    if len(sys.argv) > 1:
        arg = sys.argv[1]
        if arg in ("-h", "--help"):
            sys.stdout.write(HELP_TEXT)
            return 0
        if arg in ("--version", "-V"):
            sys.stdout.write(f"cct {CCT_VERSION}\n")
            return 0
        sys.stderr.write(f"cct: unknown argument {arg!r}.  Try `cct --help`.\n")
        return 2
    state = load_state()
    last = state.get("last_action")
    try:
        while True:
            action = entry_menu(default=last)
            if action is None:
                return 0
            last = action
            state["last_action"] = last
            save_state(state)

            if action == "current":
                cwd = Path(os.getcwd())
                sessions = sessions_in(PROJECTS_ROOT / slug_for(cwd))
                if not sessions:
                    # Empty state: offer a one-keystroke fall-through to the
                    # all-projects picker so the user isn't dumped back to
                    # the entry menu with no guidance.
                    _paint(
                        "No sessions",
                        f"No Claude Code history for this project:\n  {cwd}\n\n"
                        "Press any key to browse sessions across ALL projects,\n"
                        "or Esc / q to go back to the menu.\n",
                    )
                    sys.stdout.write("\n")
                    sys.stdout.flush()
                    ch = _read_one_key()
                    sys.stdout.write("\n")
                    if ch in ("\x1b", "q", "Q"):
                        continue
                    do_session_flow(all_sessions(), title="all projects", with_project=True)
                else:
                    do_session_flow(sessions, title=str(cwd), with_project=False)
            elif action == "all":
                do_session_flow(all_sessions(), title="all projects", with_project=True)
            elif action == "status":
                render_output_refresh(
                    lambda v: "Status",
                    lambda v: run_script("status.sh"),
                )
            elif action == "active":
                render_output_refresh(
                    lambda v: "Active sessions",
                    lambda v: run_script("active-sessions.sh"),
                )
            elif action == "cost":
                render_output_refresh(
                    lambda v: "Cost report" + (" (extended)" if v else ""),
                    lambda v: run_script("cost-report.sh", *(["-v"] if v else [])),
                    variants=2,
                    variant_names=("summary", "extended"),
                )
            elif action == "monthly":
                monthly_flow()
            elif action == "projects":
                projects_flow()
            elif action == "merged":
                merged_flow()
            elif action == "time":
                time_flow()
            elif action == "export":
                export_flow()
            elif action == "stack":
                render_output_refresh(
                    lambda v: "Stack / tech used" + (" (extended)" if v else ""),
                    lambda v: run_script("stack-report.sh", *(["-v"] if v else [])),
                    variants=2,
                    variant_names=("summary", "extended"),
                )
            elif action == "trouble":
                troubleshooting_flow()
    except KeyboardInterrupt:
        return 130

if __name__ == "__main__":
    sys.exit(main())
